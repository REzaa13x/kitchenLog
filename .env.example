# Ringkasan Serah Terima tidak membutuhkan API key AI.
# Integrasi staf Geasteats opsional, SERVER ONLY (jangan gunakan awalan VITE_).
# Set pada environment proses Node backend; Vite .env.local bukan konfigurasi backend.
GEASTEATS_URL=https://geasteats.ngolab.online
DAPUROPS_INTEGRATION_KEY=
GEASTEATS_WORKSPACE_ID=ws-u_mwsxhkk6b2fea13f
#
# CREDENTIAL_KEY: kunci untuk menampilkan kembali password akun staf ke Admin.
# Minimal 32 karakter, RAHASIA, dan jangan diubah setelah dipakai — bila kunci
# berubah, kredensial lama tidak dapat didekripsi (akun tetap bisa login karena
# password login memakai hash terpisah). Bila kosong, fitur ini nonaktif.
# CREDENTIAL_KEY=
#
# Ringkasan Serah Terima disusun sepenuhnya di sisi aplikasi
# (lihat src/utils/handoverSummary.ts) tanpa memanggil layanan AI eksternal,
# sehingga tidak ada data operasional dapur yang keluar dari server Anda.
#
# Berkas ini hanya menampung pengaturan opsional di bawah. Salin menjadi
# .env.local bila ingin mengubahnya.
#
# PORT: Port server. Bawaan 3000.
# PORT=3000
