{
  "name": "kitchenlog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "verify:handover": "tsx scripts/verify-handover-summary.ts && tsx scripts/verify-handover-component.tsx",
    "dev:demo": "tsx server/dev.ts",
    "verify:auth": "tsx scripts/verify-auth-validation.ts",
    "verify:all": "npm run verify:handover && npm run verify:auth",
    "start:api": "node server/index.js",
    "api": "node server/index.js",
    "dev:firebase": "tsx server/dev.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "build:hosting": "npm run build && npm prune --omit=dev"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  }
}
